<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- XDOX loads third-party dylibs (MBS plugins) and spawns a bundled
	     llama-server executable. Under the hardened runtime these need explicit
	     entitlements or the app is killed at launch / rejected by notarisation. -->

	<!-- Allow loading libraries not signed by us (the MBS_* plugin dylibs). -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!-- llama.cpp uses JIT / executable memory for its compute kernels. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>

	<!-- llama-server is launched as a child process reading its model from disk. -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
</dict>
</plist>
